{
  "expo": {
    "name": "Aura",
    "slug": "aura-your-space",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "updates": {
      "enabled": false,
      "fallbackToCacheTimeout": 0
    },
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#6B5CE7"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aura.yourspace"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6B5CE7"
      },
      "package": "com.aura.yourspace"
    },
    "plugins": [
      "expo-notifications"
    ]
  }
}
